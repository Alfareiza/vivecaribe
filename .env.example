# Copy to .env and fill in values. Never commit real secrets.

# local | staging | prod  (Vercel Production must use prod, not "production")
ENVIRONMENT=local
LOG_LEVEL=INFO

# Async SQLAlchemy URL — must use +asyncpg or +psycopg (plain postgresql:// fails).
# Local Docker Compose Postgres (app / manual runs — never used by pytest):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/vivecaribe
#
# Pytest creates/uses vivecaribe_test automatically (see tests/conftest.py).
# Override host/port if your test Postgres differs:
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/vivecaribe_test
#
# Supabase on Vercel (transaction pooler — port 6543). Change Supabase's postgresql://
# scheme to postgresql+asyncpg:// or postgresql+psycopg://. URL-encode special chars
# in the password (@, #, /, …) before pasting into Vercel.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres
# The app uses NullPool + statement_cache_size=0 outside ENVIRONMENT=local.

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32b
JWT_EXPIRE_MINUTES=60
# Present in Settings; automation accepts Bearer JWT or Bearer CRON_SECRET
# on GET and POST /automation/emails/get-bookings. Vercel Cron uses GET + this secret.
CRON_SECRET=change-me-to-another-long-random-string

# Optional — leave empty to disable Sentry
SENTRY_DSN=

# Gmail OAuth (shared Google Cloud app) — env only, no secrets/ files.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Per-mailbox access + refresh tokens (names referenced by apps/backend/booking_providers.yaml):
# GYG_GMAIL_TOKEN=
# GYG_GMAIL_REFRESH_TOKEN=
# VIATOR_GMAIL_TOKEN=
# VIATOR_GMAIL_REFRESH_TOKEN=

# Outlook (MSAL consumers) — env only.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# HOMEFANS_OUTLOOK_REFRESH_TOKEN=

# Zoho Mail (Playwright, free-tier web UI) — env only.
# PROPIO_ZOHO_USERNAME=
# PROPIO_ZOHO_PASSWORD=
