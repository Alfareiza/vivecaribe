# Copy to .env and fill in values. Never commit real secrets.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Async SQLAlchemy URL (asyncpg).
# Local Docker Compose Postgres:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/vivecaribe
#
# Supabase on Vercel (transaction pooler — port 6543). Use either async driver:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres
# Outside ENVIRONMENT=local the app uses NullPool and disables prepared statements
# (asyncpg: statement_cache_size=0; psycopg: prepare_threshold=None).

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
CRON_SECRET=change-me-to-another-long-random-string

# Optional — leave empty to disable Sentry
SENTRY_DSN=

# Path to non-secret mailbox/query config
ACCOUNTS_YAML_PATH=accounts.yaml
