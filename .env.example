# Copy to .env and fill in values. Never commit real secrets.

ENVIRONMENT=local
LOG_LEVEL=INFO

# PostgreSQL (Supabase connection string in staging/prod)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vivecaribe

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
CRON_SECRET=change-me-to-another-long-random-string

# Optional — leave empty to disable Sentry
SENTRY_DSN=

# Path to non-secret mailbox/query config
ACCOUNTS_YAML_PATH=accounts.yaml
